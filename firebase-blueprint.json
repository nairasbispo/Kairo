{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings, progress, and goals",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "streakDays": { "type": "number" },
        "targetLanguage": { "type": "string" },
        "goal": { "type": "string" },
        "customGoal": { "type": "string" },
        "dailyMinutes": { "type": "number" },
        "selfLevel": { "type": "string" },
        "languageLevels": { "type": "object" },
        "hoursPerLanguage": { "type": "object" },
        "totalHoursStudied": { "type": "number" },
        "weeklyGoalHours": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "name"]
    },
    "LearnedWord": {
      "title": "LearnedWord",
      "description": "Vocabulary item saved by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "language": { "type": "string" },
        "word": { "type": "string" },
        "ipa": { "type": "string" },
        "translation": { "type": "string" },
        "example": { "type": "string" },
        "category": { "type": "string" },
        "dateAdded": { "type": "string" },
        "mastered": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "word"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles indexed by UID or user identifier"
    },
    "/users/{userId}/learnedWords/{wordId}": {
      "schema": { "$ref": "#/entities/LearnedWord" },
      "description": "User's saved vocabulary items"
    }
  }
}
